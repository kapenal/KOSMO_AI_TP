    "from selenium import webdriver\n",
    "from selenium.webdriver.chrome.options import Options\n",
    "import time\n",
    "\n",
    "options = Options()\n",
    "options.add_argument('--headless')\n",
    "driver = webdriver.Chrome(options=options)\n",
    "\n",
    "url = \"https://m.kinolights.com/title/130583?tab=review\"\n",
    "driver.get(url)\n",
    "time.sleep(3)\n",
    "\n",
    "scroll_container_selector = 'section.review-list-section'  # 예시, 실제 페이지에서 확인 필요\n",
    "\n",
    "last_height = driver.execute_script(f\"\"\"\n",
    "    var container = document.querySelector('{scroll_container_selector}');\n",
    "    return container ? container.scrollHeight : 0;\n",
    "\"\"\")\n",
    "\n",
    "while True:\n",
    "    driver.execute_script(f\"\"\"\n",
    "        var container = document.querySelector('{scroll_container_selector}');\n",
    "        if(container) {{\n",
    "            container.scrollTop = container.scrollHeight;\n",
    "        }}\n",
    "    \"\"\")\n",
    "    time.sleep(2)\n",
    "\n",
    "    new_height = driver.execute_script(f\"\"\"\n",
    "        var container = document.querySelector('{scroll_container_selector}');\n",
    "        return container ? container.scrollHeight : 0;\n",
    "    \"\"\")\n",
    "\n",
    "    if new_height == last_height:\n",
    "        break\n",
    "    last_height = new_height\n",
    "\n",
    "# 전체 페이지 소스 파싱\n",
    "from bs4 import BeautifulSoup\n",
    "soup = BeautifulSoup(driver.page_source, 'html.parser')\n",
    "driver.quit()\n",
    "\n",
    "review_cards = soup.select('section.review-list-section article')\n",
    "review_list = []\n",
    "for card in review_cards:\n",
    "    name_tag = card.select_one('.title__movie-title')\n",
    "    content_tag = card.select_one('.contents__title')\n",
    "    like_tag = card.select_one('.user-star-score')\n",
    "    if name_tag and content_tag and like_tag:\n",
    "        review_list.append({\n",
    "            '닉네임': name_tag.get_text(strip=True),\n",
    "            '리뷰': content_tag.get_text(strip=True),\n",
    "            '평점': like_tag.get_text(strip=True)\n",
    "        })\n",
    "\n",
    "print(f\"총 리뷰 수: {len(review_list)}\")\n",
    "print(review_list)"
   ]
