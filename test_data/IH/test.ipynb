    "from selenium import webdriver\n",
    "from selenium.webdriver.chrome.options import Options\n",
    "from selenium.webdriver.common.by import By\n",
    "import time\n",
    "\n",
    "options = Options()\n",
    "# 디버깅을 위해 headless 모드 끔\n",
    "driver = webdriver.Chrome(options=options)\n",
    "driver.get(\"https://m.kinolights.com/title/130583?tab=review\")\n",
    "time.sleep(3)\n",
    "\n",
    "# 1. 모든 요소 중 스크롤 가능한 요소 자동 탐색\n",
    "scrollable = None\n",
    "for el in driver.find_elements(By.CSS_SELECTOR, \"*\"):\n",
    "    if driver.execute_script(\"return arguments[0].scrollHeight > arguments[0].clientHeight;\", el):\n",
    "        scrollable = el\n",
    "        break\n",
    "\n",
    "if not scrollable:\n",
    "    print(\"⚠️ 스크롤 가능한 요소를 찾을 수 없습니다.\")\n",
    "    driver.quit()\n",
    "    exit()\n",
    "\n",
    "print(\"✅ 스크롤 가능한 요소 발견:\", scrollable.tag_name)\n",
    "\n",
    "# 2. scrollIntoView 방식으로 동적 로딩 유도\n",
    "prev_count = -1\n",
    "for i in range(50):  # 최대 50회 반복\n",
    "    reviews = driver.find_elements(By.CSS_SELECTOR, '.review-card .text')\n",
    "    if len(reviews) == prev_count:\n",
    "        break\n",
    "    prev_count = len(reviews)\n",
    "    # 마지막 리뷰 카드 기준으로 스크롤 방식\n",
    "    if reviews:\n",
    "        driver.execute_script(\"arguments[0].scrollIntoView(true);\", reviews[-1])\n",
    "    else:\n",
    "        driver.execute_script(\"arguments[0].scrollTop = arguments[0].scrollHeight;\", scrollable)\n",
    "    time.sleep(1.5)\n",
    "\n",
    "# 3. 리뷰 수집\n",
    "reviews = driver.find_elements(By.CSS_SELECTOR, '.review-card .text')\n",
    "print(f\"\\n총 {len(reviews)}개의 리뷰 수집됨:\\n\")\n",
    "for idx, r in enumerate(reviews, 1):\n",
    "    print(f\"{idx}. {r.text.strip()}\\n\")\n",
    "\n",
    "driver.quit()"
   ]
  },
