    "from selenium import webdriver\n",
    "from selenium.webdriver.chrome.options import Options\n",
    "from selenium.webdriver.common.by import By\n",
    "import time\n",
    "\n",
    "options = Options()\n",
    "# headless 모드 꺼서 직접 확인\n",
    "# options.add_argument('--headless')\n",
    "driver = webdriver.Chrome(options=options)\n",
    "driver.get(\"https://m.kinolights.com/title/130583?tab=review\")\n",
    "time.sleep(3)\n",
    "\n",
    "# 스크롤 가능한 내부 컨테이너 직접 지정 (예: id='__nuxt' 또는 클래스명 등)\n",
    "scrollable = driver.find_element(By.ID, \"__nuxt\")\n",
    "\n",
    "prev_review_count = 0\n",
    "no_change_counter = 0\n",
    "max_no_change = 5  # 리뷰 수 변화 없으면 5회 후 종료\n",
    "\n",
    "while True:\n",
    "    # 마지막 리뷰를 화면에 스크롤해서 로딩 유도\n",
    "    reviews = driver.find_elements(By.CSS_SELECTOR, '.review-card .text')\n",
    "    if reviews:\n",
    "        driver.execute_script(\"arguments[0].scrollIntoView(true);\", reviews[-1])\n",
    "    else:\n",
    "        # 리뷰가 아직 없으면 전체 컨테이너 아래로 스크롤\n",
    "        driver.execute_script(\"arguments[0].scrollTop = arguments[0].scrollHeight;\", scrollable)\n",
    "\n",
    "    time.sleep(2)  # 로딩 대기 시간\n",
    "\n",
    "    current_count = len(driver.find_elements(By.CSS_SELECTOR, '.review-card .text'))\n",
    "\n",
    "    if current_count == prev_review_count:\n",
    "        no_change_counter += 1\n",
    "    else:\n",
    "        no_change_counter = 0\n",
    "        prev_review_count = current_count\n",
    "\n",
    "    if no_change_counter >= max_no_change:\n",
    "        break\n",
    "\n",
    "print(f\"\\n총 {prev_review_count}개의 리뷰 수집됨\\n\")\n",
    "reviews = driver.find_elements(By.CSS_SELECTOR, '.review-card .text')\n",
    "for idx, r in enumerate(reviews, 1):\n",
    "    print(f\"{idx}. {r.text.strip()}\\n\")\n",
    "\n",
    "driver.quit()"
   ]
  },
