s:\\u002F\\u002Ffile.kinolights.com\\u002Foriginal\\u002Fuser_profile\\u002F202405\\u002F13\\u002F28ec4a96-6f75-4b17-bf7d-f3f8262c12b7.jpeg\",__typename:f},__typename:r},watchedAt:{watchedAt:b,__typename:s},blindStatus:k,isReportedByMe:a,__typename:t,movie:u,blindLevel:k},{id:\"465402\",reviewTitle:\"어벤져스 초기에는 감동이 있다..ㅠ\",review:g,reviewLink:b,isPrivate:a,isPreview:a,hasSpoiler:a,likeCount:j,createdAt:\"2024-05-01T13:03:07.000Z\",isMyLike:a,userIndexRating:b,userStarRating:{star:aj,__typename:x},reviewer:{id:\"216969\",name:\"임쥬왕\",isPremium:a,profileImage:{pathUrl:\"https:\\u002F\\u002Ffile.kinolights.com\\u002Foriginal\\u002Fuser_profile\\u002F202404\\u002F28\\u002Fba177485-074d-4cfc-933c-e101b67e062f.jpeg\",__typename:f},__typename:r},watchedAt:{watchedAt:aP,__typename:s},blindStatus:k,isReportedByMe:a,__typename:t,movie:u,blindLevel:k},{id:\"266629\",reviewTitle:\"내 마블은 이런거였어\",review:g,reviewLink:b,isPrivate:a,isPreview:a,hasSpoiler:a,likeCount:j,createdAt:\"2023-04-22T05:43:40.000Z\",isMyLike:a,userIndexRating:{index:w,__typename:B},userStarRating:{star:aj,__typename:x},reviewer:{id:\"156651\",name:\"쿠곰라이츠\",isPremium:d,profileImage:{pathUrl:\"https:\\u002F\\u002Ffile.kinolights.com\\u002Foriginal\\u002Fuser_profile\\u002F202307\\u002F27\\u002Ff14b622b-3721-4e4b-8688-67927dd5e8ff.jpeg\",__typename:f},__typename:r},watchedAt:{watchedAt:\"2023-04-22\",__typename:s},blindStatus:k,isReportedByMe:a,__typename:t,movie:u,blindLevel:k},{id:\"1086\",reviewTitle:\"작심하고 쏟아붓는 물량공세\",review:\"아스가르드의 신 토르(크리스 헴스워스)의 이복 동생인 로키(톰 히들스턴)는 에너지원 ‘큐브’를 이용하여 외계 세력과 규합, 지구를 침공할 계획을 세운다. 로키로부터 큐브를 강탈당한 국제평화유지기구 쉴드의 국장 닉 퓨리(사무엘 L. 잭슨)는 전 세계에 흩어져있던 영웅들을 한 자리에 결집시켜 위기에 처한 지구를 구해내려 한다. 이에 쉴드의 요원 ‘블랙 위도우’ 나타샤 로마노프(스칼렛 요한슨)와 필(클락 그레그)이 각각 ‘헐크’ 브루스 배너(마크 러팔로), ‘아이언 맨’ 토니 스타크(로버트 다우니 주니어)를 불러오게 되고, 국장 역시 오랜 시간 잠들어 있었던 ‘캡틴 아메리카’ 스티브 로저(크리스 에반스)를 데려오는데 성공한다.\\n\\n한 편, 지구로 떠난 동생의 악행을 막기 위해 아스가르드에서 내려 온 ‘천둥의 신’ 토르(크리스 헤스워스)가 우연한 계기로 이들과 조우하게 되고, 서로 목적이 같음을 알게 된 그가 마지막으로 합류하면서 쉴드의 전력은 한층 더 강화된다. 큐브를 사수하던 중, 로키로부터 의식을 지배 받게 된 ‘호크 아이’ 클린트 바튼(제레미 레너)을 제외한 나머지의 멤버들은 이제, 적으로부터 지구를 구해내기 위한 ‘어벤져스’ 작전을 시작한다.\\n\\n\\u003C어벤져스\\u003E의 줄거리는 간단하다. 플롯 역시 단순하다. 사실 더 복잡할 필요도 없다. 슈퍼 히어로들이 모여서 할 게 액션 밖에 더 있겠는가? 그들을 모은 영화의 목적이 분명한 이상 돌아갈 필요 없이 직구로 승부하면 그만이다. 구성은 그저 거들뿐이다. 그렇다면 결국 승부를 결정짓는 것은 이 직구가 보여주는 속도 일텐데, 과연 이 영화의 구속은 어떨까.\\n\\n\\u003C어벤져스\\u003E는 크게 영웅들의 만남, 갈등, 단결, 전투와 같이 4단계로 잘라 볼 수 있다. 먼저 영화 초반 히어로들을 모으고 이들이 만나는 과정을 따라가는 만남 시퀀스는 드문드문 존재하는 액션씬에도 불구하고 다소 루즈하게 흘러간다. 마블의 이전 히어로 시리즈를 미처 보지 못한 관객이라면, 캐릭터를 언급하거나 주요 사건을 복기하는 몇 몇 대사들을 완전히 이해하지 못한 채 흘려보낼 지도 모른다.\\n\\n휴화산이던 영화는 서로 마찰을 빚는 단계부터 조금씩 변화하기 시작한다. 살짝 살짝 화산재를 내 뱉으며 불기둥을 뿜어낼 준비를 하던 영화는, 그들이 단결하여 악당과 싸우는 클라이막스에 이르자 본격적으로 폭발하면서 오직 블록버스터만이 선보일 수 있는 장엄한 위용을 뽐낸다.\\n\\n마블의 영화를 전혀 접하지 않아 연신 하품을 하던 관객도 \\u003C어벤져스\\u003E가 작심하고 보여주는 이 후반 전투에서는 두 손을 들며 환호하게 될 듯 싶다. 재미의 8할 이상이 할애 되었다고 말해도 과언이 아닌 이 시퀀스에서, 영화는 오직 할리우드의 막대한 자본과 3D기술만이 해낼 수 있는 황홀경을 선사하며 관객들로 하여금 넋을 잃고 스크린 속에 빠져들게 만든다. 유머 역시 괜찮(은 듯 보인)다. 깔아 놓은 여러 개의 유머 중 대부분이 관객을 들썩거리게 했고, 개중엔 자지러지게 만들 정도의 지뢰들도 몇 개 숨어 있었다.\\n\\n그러나 마블 코믹스 만화를 오직 영화로만 접한 입장에서 영화만 두고 \\u003C어벤져스\\u003E를 본다면 고개를 갸우뚱하게 만드는 부분들이 다소 존재했다. 먼저 가장 납득하기 힘든 건 ‘헐크’의 캐릭터다. \\u003C헐크\\u003E나 \\u003C인크레더블 헐크\\u003E에서 다른 히어로들과 다르게 헐크가 자신의 변신을 애써 막으려는 이유는 변신 후 이성을 통제하는 것이 불가능하기 때문이다. 이것은 헐크 시리즈의 이야기를 지탱하는 뿌리이기도 하다. \\u003C인크레더블 헐크\\u003E에서 '분노를 억제하지 못하는 것'에 대한 해결책을 제시해 주긴 하였으나, 여전히 배너 박사에겐 변화 후의 문제가 남아있으며, 이는 그를 은둔하게 만드는 주 원인이다.\\n\\n\\u003C어벤져스\\u003E 또한 \\u003C인크레더블 헐크\\u003E가 건넨 이 캐릭터 설정 바통을 그대로 이어받아 활용한다. 닉 퓨리는 헐크의 위험성을 염려해 그가 가진 힘 대신, 감마선을 찾기 위한 용도로만 그를 활용하려 하고, 만약의 상황을 위해 따로 대책까지 마련해 놓는다. 그러나 영화 후반, 이 설정은 온데 간데 사라지고 그 자리에는 또 다른 헐크가 놓여진다. 이성적인 판단이 전혀 안 되는 듯 보였던 헐크가 이렇다 할 설명 없이 피아 구분을 확실하게 해 내고 있는 것. 그는 한 술 더 떠 적의 말을 듣기도 하고, 친절하게 대답까지 해 준다. 만약 헐크가 자신의 이성을 통제할 수 있었다면, 본부에서 보여준 그의 말이나 행동, 변신으로 인해 벌어진 일련의 위기 상황은 어떻게 받아들여야 할지 난감하다.\\n\\n두 번째로는 액션에서 보여지는 인물들의 내구력이다. 영화 속 히어로들은 적의 공격을 아무리 많이 받아도 하나같이 다 멀쩡하다. 종종 인상을 찡그리거나 배를 부여잡기도 하나, 그 때 뿐이다. 여전히 그들은 말짱한 몸으로 끝까지 남아 전투에 임한다. 때문에 화려한 액션에서 오는 장르적 쾌감은 충만할지언정 아슬아슬한 긴장을 느끼기는 힘들다.\\n\\n제일 약한 설정의 캐릭터 하나 정도는 위기에 빠뜨리거나 열외를 시켜 드라마를 극대화 할 법도 한데 영화는 당최 관심이 없다. 지칠 줄 모르는 이 히어로들이 구멍 뚫린 하늘에서 쏟아지는 무수한 적들과 끊임없이 싸우는 장면은, 흡사 ‘무적 치트키‘를 입력하고 컴퓨터와 7:1 Melee로 싸우는 스타크래프트 게임을 연상케 한다.\\n\\n마블 코믹스 영화를 \\u003C어벤져스\\u003E로 처음 접하려는 관객이 있다면 극장에 가기 전, \\u003C토르\\u003E와 \\u003C아이언 맨\\u003E정도는 보고 가길 권한다. 메인 빌런을 \\u003C토르\\u003E에서 온전히 가져왔으며, \\u003C아이언 맨\\u003E은 캐릭터와 사건 이해에 도움을 주기 때문. 시간이 허락할 경우 \\u003C퍼스트 어벤져\\u003E까지 봐주면 더 할 나위 없이 완벽하다. \\u003C헐크\\u003E나 \\u003C인크레더블 헐크\\u003E는 보지 않아도 좋다. 헐크의 기본 설정 정도만 알고 있다면 그걸로 족하다.\\n\\n\\u003C어벤져스\\u003E는 슈퍼 히어로 영화가 보여줄 수 있는 거의 모든 것을 구현한 영화다. DC나 마블을 막론하고 코믹스 영화 자체를 그렇게까지 즐기진 않는 터라 스펙타클한 액션씬에 감복할 정도는 아니었지만, 폭발력 넘치는 액션만큼은 충분히 매력적이었다. 그러니 마블 코믹스 팬들이라면 아마 비교도 할 수 없을 정도로 훨씬 더 즐거워하지 않을까.\",reviewLink:b,isPrivate:a,isPreview:a,hasSpoiler:a,likeCount:j,createdAt:\"2018-01-07T05:03:07.000Z\",isMyLike:a,userIndexRating:{index:w,__typename:B},userStarRating:{star:U,__typename:x},reviewer:{id:\"23\",name:\"선우\",isPremium:d,profileImage:{pathUrl:\"https:\\u002F\\u002Ffile.kinolights.com\\u002Foriginal\\u002Fuser_profile\\u002F202307\\u002F20\\u002F612dab6f-07b2-489b-917a-2ab9bc71c270.jpg\",__typename:f},__typename:r},watchedAt:{watchedAt:\"2018-01-07\",__typename:s},blindStatus:k,isReportedByMe:a,__typename:t,movie:u,blindLevel:k},{id:\"624313\",reviewTitle:\"어벤져스 어셈블\",review:g,reviewLink:b,isPrivate:a,isPreview:a,hasSpoiler:a,likeCount:c,createdAt:\"2025-07-14T12:43:01.000Z\",isMyLike:a,userIndexRating:{index:w,__typename:B},userStarRating:{star:J,__typename:x},reviewer:{id:\"59099\",name:\"녜원\",isPremium:a,profileImage:{pathUrl:\"https:\\u002F\\u002Ffile.kinolights.com\\u002Foriginal\\u002Fuser_profile\\u002F202507\\u002F12\\u002F9c64a623-05e2-4c5d-b651-7367af02f895.jpeg\",__typename:f},__typename:r},watchedAt:{watchedAt:\"2023-08-06\",__typename:s},blindStatus:k,isReportedByMe:a,__typename:t,movie:u,blindLevel:k}]}],prices:[],filmo:[],recommendations:[],recommendationLength:c,recommendSelectedChannels:[],hasMoreRecommendation:a,randomM