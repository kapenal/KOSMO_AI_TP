    "from bs4 import BeautifulSoup\n",
    "import urllib.request\n",
    "from urllib.parse import quote\n",
    "import json\n",
    "\n",
    "search_text = \"드래곤\"\n",
    "encoded_text = quote(search_text)\n",
    "url = f\"https://m.kinolights.com/search?keyword={encoded_text}\"\n",
