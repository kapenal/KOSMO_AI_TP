    "from selenium import webdriver\n",
    "from selenium.webdriver.chrome.options import Options\n",
    "from selenium.webdriver.common.by import By\n",
    "import time\n",
    "from bs4 import BeautifulSoup\n",
    "\n",
    "options = Options()\n",
    "# options.add_argument('--headless')  # 필요 시 켜기\n",
    "driver = webdriver.Chrome(options=options)\n",
    "driver.get(\"https://m.kinolights.com/title/135607?tab=review\")\n",
    "time.sleep(3)\n",
    "\n",
    "scrollable = driver.find_element(By.ID, \"content__body\")\n",
    "\n",
    "prev_count = 0\n",
    "no_change_count = 0\n",
    "max_no_change = 10\n",
    "max_wait_seconds = 90  # 좀 더 여유 있게\n",
    "start_time = time.time()\n",
    "\n",
    "driver.execute_script(\"arguments[0].scrollTop = arguments[0].scrollHeight\", scrollable)\n",
    "time.sleep(3)\n",
    "\n",
    "while True:\n",
    "    reviews = driver.find_elements(By.CSS_SELECTOR, '.review-card .text')\n",
    "    current_count = len(reviews)\n",
    "\n",
    "    print(f\"현재 리뷰 개수: {current_count}, 이전 리뷰 개수: {prev_count}\")\n",
    "\n",
    "    if current_count > prev_count:\n",
    "        prev_count = current_count\n",
    "        no_change_count = 0\n",
    "    else:\n",
    "        no_change_count += 1\n",
    "\n",
    "    if no_change_count >= max_no_change:\n",
    "        print(f\"{max_no_change}번 연속 리뷰 수 변화 없음, 종료합니다.\")\n",
    "        break\n",
    "\n",
    "    if time.time() - start_time > max_wait_seconds:\n",
    "        print(\"최대 대기 시간 초과, 종료합니다.\")\n",
    "        break\n",
    "\n",
    "    if reviews:\n",
    "        driver.execute_script(\"arguments[0].scrollIntoView(true);\", reviews[-1])\n",
    "    else:\n",
    "        driver.execute_script(\"arguments[0].scrollTop = arguments[0].scrollHeight\", scrollable)\n",
    "\n",
    "    time.sleep(3)  # 좀 더 기다리기\n",
    "\n",
    "html = driver.page_source\n",
    "driver.quit()\n",
    "\n",
    "soup = BeautifulSoup(html, 'html.parser')\n",
    "review_cards = soup.select('section.review-list-section article')\n",
    "\n",
    "review_list = []\n",
    "for card in review_cards:\n",
    "    name = card.select_one('.title__movie-title')\n",
    "    content = card.select_one('.contents__title')\n",
    "    like = card.select_one('.user-star-score')\n",
    "\n",
    "    name_text = name.get_text(strip=True) if name else ''\n",
    "    content_text = content.get_text(strip=True) if content else ''\n",
    "    like_text = like.get_text(strip=True) if like else ''\n",
    "\n",
    "    review_list.append({\n",
    "        '닉네임': name_text,\n",
    "        '리뷰': content_text,\n",
    "        '평점': like_text\n",
    "    })\n",
    "\n",
    "print(f\"\\n총 {len(review_list)}개의 리뷰를 수집했습니다.\\n\")\n",
    "for i, review in enumerate(review_list, 1):\n",
    "    print(f\"{i}. 닉네임: {review['닉네임']}\")\n",
    "    print(f\"   리뷰: {review['리뷰']}\")\n",
    "    print(f\"   평점: {review['평점']}\\n\")"
   ]
  },
